
#!/usr/bin/env python3

import time
from panda import Panda
from opendbc.car.structs import CarParams

TX_BUS = 2
CAN_ID = 0x123
INTERVAL = 1.0

def main():
    p = Panda()

    print("Panda:", p.get_serial()[0])
    print("Versao:", p.get_version())

    p.set_can_speed_kbps(0, 500)
    p.set_can_speed_kbps(2, 500)

    p.can_clear(0xFFFF)
    p.set_safety_mode(CarParams.SafetyModel.allOutput)

    sequence = 0
    received_count = 0

    print("\nTeste de encaminhamento CAN")
    print(f"Enviando pelo bus {TX_BUS}")
    print(f"ID: 0x{CAN_ID:X}")
    print("Aguardando recebimento...\n")

    last_send = 0

    try:
        while True:
            now = time.monotonic()

            # Envia uma mensagem por segundo
            if now - last_send >= INTERVAL:
                payload = (
                    b"TEST" +
                    sequence.to_bytes(4, "big")
                )

                p.can_send(CAN_ID, payload, TX_BUS)

                print(
                    f"\n[TX] bus={TX_BUS} "
                    f"ID=0x{CAN_ID:X} "
                    f"SEQ={sequence} "
                    f"DATA={payload.hex(' ')}"
                )

                sequence += 1
                last_send = now

            # Recebe mensagens
            frames = p.can_recv()

            for addr, data, bus in frames:

                if addr == CAN_ID and data[:4] == b"TEST":

                    seq = int.from_bytes(data[4:8], "big")

                    received_count += 1

                    print(
                        f"[RX] bus={bus} "
                        f"ID=0x{addr:X} "
                        f"SEQ={seq} "
                        f"DATA={data.hex(' ')} "
                        f"TOTAL={received_count}"
                    )

                    if bus == TX_BUS:
                        print("     -> Apareceu no mesmo barramento da transmissao")

                    else:
                        print("     -> Apareceu em outro barramento!")

            time.sleep(0.001)

    except KeyboardInterrupt:
        print("\nTeste interrompido.")

    finally:
        p.set_safety_mode(CarParams.SafetyModel.noOutput)
        print("Transmissao desabilitada.")


if __name__ == "__main__":
    main()
